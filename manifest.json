{
  "manifest_version": 3,
  "name": "Pixiv Keyboard Pagination",
  "version": "0.1.0",
  "description": "Keyboard pagination for Pixiv.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pixiv.net/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}